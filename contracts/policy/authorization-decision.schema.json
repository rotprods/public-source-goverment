{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://public-source-goverment.local/contracts/policy/authorization-decision.schema.json",
  "title": "AuthorizationDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "requested_action",
    "policy_type",
    "policy_version",
    "reason_codes",
    "evaluated_at"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "REQUIRE_STEP_UP", "REQUIRE_SECOND_APPROVER"]
    },
    "requested_action": { "type": "string", "minLength": 1 },
    "matched_capability": { "type": ["string", "null"] },
    "matched_assignment_id": { "type": ["string", "null"], "format": "uuid" },
    "policy_type": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "policy_body_sha256": { "type": ["string", "null"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "AUDIT_RECEIPT",
          "STEP_UP_AUTH",
          "SECOND_APPROVER",
          "REDACT_RESPONSE",
          "LIMIT_SCOPE",
          "REAUTHENTICATE"
        ]
      },
      "uniqueItems": true
    },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
