{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://public-source-goverment.local/contracts/policy/capability-assignment.schema.json",
  "title": "CapabilityAssignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment_id",
    "subject_ref",
    "capability",
    "scope",
    "grant_authority_ref",
    "grant_policy_ref",
    "valid_from",
    "status"
  ],
  "properties": {
    "assignment_id": { "type": "string", "format": "uuid" },
    "subject_ref": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_ref": { "type": ["string", "null"] },
        "territory_id": { "type": ["string", "null"], "format": "uuid" },
        "competence_node_id": { "type": ["string", "null"], "format": "uuid" },
        "topic_id": { "type": ["string", "null"], "format": "uuid" },
        "process_id": { "type": ["string", "null"], "format": "uuid" },
        "resource_type": { "type": ["string", "null"] },
        "resource_id": { "type": ["string", "null"], "format": "uuid" },
        "owner_only": { "type": "boolean", "default": false }
      }
    },
    "credential_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "grant_authority_ref": { "type": "string", "minLength": 1 },
    "grant_policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_type", "policy_version"],
      "properties": {
        "policy_type": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "body_sha256": { "type": ["string", "null"] }
      }
    },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "REVOKED"] },
    "revocation_reason": { "type": ["string", "null"] }
  }
}
